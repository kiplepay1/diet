# Copy this file to .env.local and fill in your Firebase Web App config.
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set true only if you want to run the app without Firebase.
# Demo mode stores data in this browser's localStorage and is not cloud-synced.
VITE_DEMO_MODE=true
